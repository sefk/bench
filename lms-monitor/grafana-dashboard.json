{
  "title": "LM Studio Activity",
  "uid": "lms-activity",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "grafana-sqlite-datasource",
        "current": {},
        "hide": 0,
        "label": "SQLite datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Model phase (idle / prefill / decode)",
      "type": "state-timeline",
      "datasource": { "type": "grafana-sqlite-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 0, "fillOpacity": 100 },
          "mappings": [],
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*" }, "properties": [] }
        ]
      },
      "options": { "mergeValues": true, "showValue": "never" },
      "targets": [
        {
          "refId": "A",
          "queryText": "SELECT ts * 1000 AS time, model, status AS value FROM model_status ORDER BY ts",
          "queryType": "table"
        }
      ]
    },
    {
      "id": 2,
      "title": "Queued requests per model",
      "type": "timeseries",
      "datasource": { "type": "grafana-sqlite-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "queryText": "SELECT ts * 1000 AS time, model, queued AS value FROM model_status ORDER BY ts",
          "queryType": "table"
        }
      ]
    },
    {
      "id": 3,
      "title": "TTL remaining per model",
      "type": "timeseries",
      "datasource": { "type": "grafana-sqlite-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "queryText": "SELECT ts * 1000 AS time, model, ttl_remaining_s AS value FROM model_status ORDER BY ts",
          "queryType": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Decode throughput (tokens/sec) per finished request",
      "type": "timeseries",
      "datasource": { "type": "grafana-sqlite-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "tps", "min": 0 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "queryText": "SELECT ts * 1000 AS time, model, tokens_per_second AS value FROM predictions ORDER BY ts",
          "queryType": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "Time to first token (prefill latency) per finished request",
      "type": "timeseries",
      "datasource": { "type": "grafana-sqlite-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "queryText": "SELECT ts * 1000 AS time, model, time_to_first_token_s AS value FROM predictions ORDER BY ts",
          "queryType": "table"
        }
      ]
    },
    {
      "id": 6,
      "title": "Recent finished requests",
      "type": "table",
      "datasource": { "type": "grafana-sqlite-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "queryText": "SELECT datetime(ts, 'unixepoch', 'localtime') AS time, model, prompt_tokens, completion_tokens, ROUND(tokens_per_second, 1) AS tok_per_sec, time_to_first_token_s AS ttft_s, stop_reason FROM predictions ORDER BY ts DESC LIMIT 50",
          "queryType": "table"
        }
      ]
    }
  ]
}
