#!/usr/bin/env python3
"""Benchmark LM Studio models using the server's own perf counters.

LM Studio reports tokens/sec and time-to-first-token per request, but only on
its native `/api/v0/chat/completions` endpoint -- the OpenAI-compatible `/v1`
route returns an empty `stats` object. That is why pi transcripts (and so
AgentsView) have no throughput data: pi talks to `/v1`. This script talks to
`/api/v0` directly and reads the numbers off each response.

Also benchmarks Apple's on-device Foundation Model (macOS 27+) via `fm serve`,
addressed as `fm:system`. That server speaks the same chat-completions dialect
but reports no token usage at all, which is why every backend is additionally
timed client-side -- see below.

Measures per target, at one or more prompt sizes:

  gen tok/s     generation throughput once decoding starts
  ttft          time to first token (dominated by prefill of the prompt)
  total         wall-clock from request to last token: what you actually wait
  prefill tok/s prompt tokens / ttft -- how fast it chews through context

Two clocks, deliberately
------------------------
`ttft`/`gen_tps` come from the server's own counters where it has them, so that
two builds under the same server compare without HTTP and queueing noise, and
so rows stay comparable with runs recorded before this tool streamed at all.

`ttft_client`/`decode_tps`/`total_s` are measured here, at the socket. They are
slightly pessimistic -- they include transport -- but they mean the same thing
for every backend, which is the only way an Apple-vs-Qwen latency number is
worth printing. When a comparison spans backends, use these.

Notes on methodology:

- Each run is prefixed with a unique nonce so LM Studio's KV cache can never be
  reused across runs. Without this, every run after the first reports an
  implausibly fast ttft and the prefill number is meaningless.
- One warm-up run per model/size is discarded, so model load time and first-run
  Metal shader compilation stay out of the results.
- Every other model is unloaded before benchmarking, both to free memory (a
  large model otherwise trips LM Studio's loading guardrails) and to keep runs
  from competing for the same GPU.
- Reported values are medians across runs.
- LM Studio answers a request for a variant it cannot resolve with whichever
  model is already resident, and does not say so. Every response's `model` is
  checked against the id that was asked for, so a deleted variant fails loudly
  instead of quietly reporting the resident model's numbers under its name.
"""

import argparse
import json
import os
import random
import re
import shutil
import statistics
import subprocess
import sys

import time
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

HOST = "http://localhost:1234"
MODELS_URL = f"{HOST}/api/v0/models"
CHAT_URL = f"{HOST}/api/v0/chat/completions"

# Apple's on-device Foundation Model, served by `fm serve` (macOS 27+). It
# speaks the OpenAI chat-completions dialect but always streams and never
# reports token usage, so its numbers have to be taken client-side. Targets
# are addressed as "fm:system".
FM_PORT = 1976
FM_HOST = f"http://localhost:{FM_PORT}"
FM_CHAT_URL = f"{FM_HOST}/v1/chat/completions"

LMS_BIN = shutil.which("lms") or str(Path.home() / ".lmstudio" / "bin" / "lms")

# Rough chars-per-token for English prose. Only used to size the filler prompt,
# so the exact ratio does not matter -- actual prompt_tokens is read back from
# the response and used for the prefill rate.
CHARS_PER_TOKEN = 4

# Filler is built by drawing words at random from this pool, seeded per run.
# A fixed passage with only a varying prefix is NOT enough to defeat the KV
# cache: two such prompts share thousands of identical trailing tokens, and
# LM Studio can still reuse most of the prefill, reporting a ttft an order of
# magnitude too fast. Seeding the body itself guarantees no two runs share
# anything reusable.
WORDS = (
    "river stone quiet ledger amber tunnel govern plaza thicket vanish copper "
    "marsh bracket signal orchard tidal ferment lattice gasket murmur pivot "
    "cinder waggon fluent basin trellis harbor kindle nomad splice yonder "
    "drift kernel opaque brisk furrow candid lumen tessera warp glean sundry"
).split()

################################################################################
# LM Studio plumbing


def http_json(url, payload=None, timeout=600):
    data = json.dumps(payload).encode() if payload is not None else None
    headers = {"Content-Type": "application/json"} if data else {}
    req = urllib.request.Request(url, data=data, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.load(resp)


def list_models():
    """Chat models LM Studio has on disk, in its own order."""
    try:
        data = http_json(MODELS_URL)["data"]
    except urllib.error.URLError as exc:
        sys.exit(f"Cannot reach LM Studio at {HOST}: {exc}\nIs the server running?")
    return [m["id"] for m in data if m.get("type") in ("llm", "vlm")]


def lms(*args):
    """Run an lms subcommand, returning stdout (empty string on failure)."""
    try:
        done = subprocess.run(
            [LMS_BIN, *args], capture_output=True, text=True, timeout=120
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return done.stdout if done.returncode == 0 else ""


def loaded_models():
    """Ids of models currently resident, or None if lms could not be queried."""
    out = lms("ps", "--json")
    if not out:
        return None
    try:
        return [m["identifier"] for m in json.loads(out)]
    except (json.JSONDecodeError, KeyError, TypeError):
        return None


def unload_all(settle=30):
    """Unload every resident model so each benchmark starts from a clean slate.

    `lms unload` returns before the unload has actually completed, so we poll
    until nothing is resident. Skipping the poll means the next request can
    reach a model mid-teardown and fail with "Model has not started
    loading/has been unloaded."
    """
    resident = loaded_models()
    if not resident:
        return
    for model in resident:
        lms("unload", model)

    deadline = time.monotonic() + settle
    while time.monotonic() < deadline:
        if not loaded_models():
            return
        time.sleep(0.5)


################################################################################
# Power measurement
#
# powermetrics is root-only, and this tool deliberately does not invoke sudo.
# Instead the caller starts powermetrics separately (see --power-log) and this
# reads the log it produces, matching samples to benchmark rows by wall-clock
# time.
#
# On a machine that is left powered on anyway, the interesting number is not
# total draw but the *increment* over idle. So the baseline is taken from
# samples that fall outside every benchmark window -- the gaps while models
# load and unload -- and subtracted.
#
# What is measured is SoC package power (CPU + GPU + ANE). It excludes DRAM,
# PSU losses, and everything else in the machine.

ELAPSED_RE = re.compile(r"\(([\d.]+)ms elapsed\)")
POWER_RE = re.compile(r"^(CPU|GPU|ANE|Combined) Power[^:]*:\s+([\d.]+)\s*(m?W)", re.M)
STAMP_RE = re.compile(r"\*\*\* Sampled system activity \(([^)]+?)\)\s*\(")


class PowerLog:
    """Reads a powermetrics log produced by someone else and attributes it.

    Samples are timestamped with wall-clock dates, so benchmark windows are
    recorded in wall-clock time too and the two are matched directly. That
    avoids needing to know when powermetrics was started.
    """

    def __init__(self, path):
        self.path = path
        self.samples = []  # (midpoint_epoch, duration_s, watts)
        self.idle_watts = None

    def parse(self):
        try:
            text = open(self.path, errors="replace").read()
        except OSError as exc:
            print(f"WARNING: cannot read power log {self.path}: {exc}",
                  file=sys.stderr)
            return

        for block in re.split(r"(?=\*\*\* Sampled system activity)", text):
            stamp = STAMP_RE.search(block)
            elapsed = ELAPSED_RE.search(block)
            if not (stamp and elapsed):
                continue
            when = self._parse_stamp(stamp.group(1))
            if when is None:
                continue
            dur = float(elapsed.group(1)) / 1000.0
            found = {k: (float(v) / 1000.0 if u == "mW" else float(v))
                     for k, v, u in POWER_RE.findall(block)}
            watts = found.get("Combined")
            if watts is None:
                watts = sum(found.get(k, 0.0) for k in ("CPU", "GPU", "ANE"))
            if watts > 0:
                # Timestamp marks the end of the sample; centre it.
                self.samples.append((when - dur / 2, dur, watts))

    @staticmethod
    def _parse_stamp(raw):
        # e.g. "Sat Aug  2 14:23:45 2026 -0700" -- day is space-padded, so
        # collapse runs of whitespace before handing it to strptime.
        cleaned = " ".join(raw.split())
        for fmt in ("%a %b %d %H:%M:%S %Y %z", "%a %b %d %H:%M:%S %Y"):
            try:
                return datetime.strptime(cleaned, fmt).timestamp()
            except ValueError:
                continue
        return None

    def compute_idle(self, windows, guard=10.0, quantile=0.25):
        """Baseline draw, from samples well outside every benchmark window.

        A baseline that is too high silently understates the incremental
        energy, so this errs low:

        - a guard band, since the GPU neither drops to idle the instant a run
          ends nor ramps instantly at the next one;
        - a low quantile rather than the mean or median. The out-of-window
          samples are not all idle: model loading falls in the gaps, and when
          several benchmarks share one power log, each run's gaps contain the
          *other* runs. Idle is the floor of that mixture, so a low quantile
          finds it where an average would land somewhere in the traffic.
        """
        outside = sorted(w for mid, _, w in self.samples
                         if not any(s - guard <= mid <= e + guard for s, e in windows))
        if outside:
            idx = min(len(outside) - 1, int(len(outside) * quantile))
            self.idle_watts = outside[idx]
        return self.idle_watts

    def window(self, start, end):
        """Mean watts, total Wh, and Wh above idle, for one benchmark window."""
        hits = [(d, w) for mid, d, w in self.samples if start <= mid <= end]
        if not hits:
            return None, None, None
        joules = sum(d * w for d, w in hits)
        span = sum(d for d, _ in hits)
        mean_w = joules / span
        wh = joules / 3600.0
        incr_wh = None
        if self.idle_watts is not None:
            incr_wh = max(0.0, (mean_w - self.idle_watts)) * span / 3600.0
        return mean_w, wh, incr_wh


################################################################################
# Benchmark


def build_prompt(nonce, prompt_tokens):
    """A prompt of roughly prompt_tokens whose every token is unique to `nonce`.

    Both the leading marker and the whole body are derived from the nonce, so
    no two runs share a reusable prefix of any length and LM Studio must do the
    full prefill every time.
    """
    head = f"[run {nonce}] "
    if prompt_tokens <= 0:
        return head + "Count from 1 to 20, one number per line."
    rng = random.Random(nonce)
    target = prompt_tokens * CHARS_PER_TOKEN
    words, length = [], 0
    while length < target:
        word = rng.choice(WORDS)
        words.append(word)
        length += len(word) + 1
    return (
        head
        + "Read the following word list, then reply with a single short "
        + "sentence about it.\n\n"
        + " ".join(words)
    )


def stream_request(url, payload):
    """Stream one chat completion, timing it from the client's side.

    Server-reported stats are the right thing to use when comparing two builds
    under the same server, because they exclude HTTP and queueing overhead. But
    they are not available everywhere and are not defined identically
    everywhere: `fm serve` reports nothing at all. So every backend is also
    timed here, at the socket, where the clock means the same thing for all of
    them -- which is what makes an Apple-vs-Qwen latency comparison honest.

    Returns client-measured time to first token, total time to the last token,
    the accumulated text, and whatever usage/stats the server volunteered.
    """
    body = dict(payload, stream=True)
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "Accept": "text/event-stream"},
    )

    chunks = []
    started = time.monotonic()
    first_token_at = None
    usage, stats, served_model = {}, {}, None

    with urllib.request.urlopen(req, timeout=900) as resp:
        for raw_line in resp:
            line = raw_line.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            try:
                event = json.loads(data)
            except json.JSONDecodeError:
                continue
            served_model = event.get("model") or served_model
            usage = event.get("usage") or usage
            stats = event.get("stats") or stats
            for choice in event.get("choices", []):
                piece = (choice.get("delta") or {}).get("content")
                if piece:
                    # First *content* token, not the first SSE event: the
                    # opening chunk carries only the assistant role and would
                    # flatter ttft by however long the role chunk arrives early.
                    if first_token_at is None:
                        first_token_at = time.monotonic()
                    chunks.append(piece)

    total = time.monotonic() - started
    return {
        "text": "".join(chunks),
        "ttft_client": (first_token_at - started) if first_token_at else total,
        "total_s": total,
        "usage": usage,
        "stats": stats,
        "served_model": served_model,
    }


def fm_count_tokens(text):
    """Prompt length per Apple's own tokenizer -- `fm serve` reports no usage."""
    out = subprocess.run(
        ["fm", "count-tokens", "--quiet", text],
        capture_output=True,
        text=True,
        check=False,
    )
    digits = re.findall(r"\d+", out.stdout)
    return int(digits[-1]) if digits else 0


def ensure_fm_server():
    """Start `fm serve` unless something already answers on its port."""
    try:
        urllib.request.urlopen(f"{FM_HOST}/health", timeout=2).read()
        return None
    except Exception:
        pass
    proc = subprocess.Popen(
        ["fm", "serve", "--port", str(FM_PORT)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    for _ in range(60):
        try:
            urllib.request.urlopen(f"{FM_HOST}/health", timeout=2).read()
            return proc
        except Exception:
            time.sleep(0.5)
    proc.terminate()
    raise RuntimeError(f"fm serve did not come up on port {FM_PORT}")


def split_target(target):
    """"fm:system" -> ("fm", "system"); anything else is an LM Studio id."""
    backend, sep, model = target.partition(":")
    if sep and backend in ("fm", "lmstudio"):
        return backend, model
    return "lmstudio", target


def one_run(model, prompt, max_tokens, backend="lmstudio"):
    """One timed request against either backend.

    Every row carries both clocks where both exist:

      ttft / gen_tps         the server's own counters (LM Studio only)
      ttft_client / total_s  measured here, comparable across backends

    `total_s` is the number the user actually waits: prompt in, last token out.
    """
    url = FM_CHAT_URL if backend == "fm" else CHAT_URL
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": max_tokens,
        "temperature": 0,
    }
    result = stream_request(url, payload)

    # LM Studio answers an unresolvable `model@variant` with whichever model is
    # already resident, silently. Benchmarking that would file one model's
    # numbers under another model's name, so refuse to.
    served = result["served_model"]
    if backend == "lmstudio" and served and served != model:
        raise RuntimeError(
            f"asked for {model!r} but the server answered as {served!r} -- "
            "that variant is probably not on disk"
        )

    usage = result["usage"] or {}
    stats = result["stats"] or {}

    prompt_tokens = usage.get("prompt_tokens") or 0
    completion_tokens = usage.get("completion_tokens") or 0
    if backend == "fm":
        prompt_tokens = fm_count_tokens(prompt)
        completion_tokens = fm_count_tokens(result["text"])
    if not completion_tokens:
        raise RuntimeError("no completion tokens reported or counted")

    ttft_client = result["ttft_client"]
    total_s = result["total_s"]

    # Decode rate from the client clock: everything after the first token.
    decode_window = total_s - ttft_client
    decode_tps = (completion_tokens - 1) / decode_window if decode_window > 0 else 0.0

    # Prefer the server's figures when it has them, so rows stay comparable
    # with runs recorded before client-side timing existed.
    ttft = stats.get("time_to_first_token") or ttft_client
    gen_tps = stats.get("tokens_per_second") or decode_tps

    return {
        "gen_tps": gen_tps,
        "decode_tps": decode_tps,
        "ttft": ttft,
        "ttft_client": ttft_client,
        "total_s": total_s,
        "prefill_tps": prompt_tokens / ttft if ttft else 0.0,
        "prompt_tokens": prompt_tokens,
        "completion_tokens": completion_tokens,
        "wall": total_s,
    }


def bench_model(target, sizes, runs, max_tokens, verbose, unload=True, power=None):
    """Benchmark one target across prompt sizes. Yields a result row per size."""
    backend, model = split_target(target)
    print(f"\n{target}", file=sys.stderr)
    if backend == "fm":
        # Apple's model lives outside LM Studio's memory accounting, so there
        # is nothing to unload -- but LM Studio must still be drained, or a
        # resident 20 GB model competes for the same GPU.
        ensure_fm_server()
        if unload:
            unload_all()
    # With --no-unload the caller has already loaded exactly the instance it
    # wants -- typically a specific quantization variant, which JIT loading
    # cannot select since the API exposes only base model ids.
    elif unload:
        unload_all()

    for size in sizes:
        label = "short" if size <= 0 else f"{size}tok"
        samples = []

        # Warm-up: loads the model and compiles kernels. Discarded. Retried
        # once, since a JIT load racing a just-finished unload can fail
        # transiently even after unload_all() has waited.
        try:
            try:
                one_run(model, build_prompt("warmup", size), max_tokens, backend)
            except urllib.error.HTTPError:
                time.sleep(2)
                one_run(model, build_prompt("warmup-retry", size), max_tokens, backend)
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode(errors="replace")
            try:
                detail = json.loads(detail).get("error", {}).get("message", detail)
            except (json.JSONDecodeError, AttributeError):
                pass
            print(f"  {label}: SKIPPED -- {detail.strip()[:160]}", file=sys.stderr)
            break  # the model will not load at all; skip its remaining sizes
        except (RuntimeError, urllib.error.URLError) as exc:
            print(f"  {label}: SKIPPED -- {exc}", file=sys.stderr)
            break

        # Timed from after the warm-up, so model load and shader compilation
        # are excluded from the energy attributed to this row. Wall-clock,
        # to match powermetrics' own timestamps.
        win_start = time.time() if power else None
        for i in range(runs):
            try:
                sample = one_run(
                    model, build_prompt(f"{label}-{i}", size), max_tokens, backend
                )
            except (RuntimeError, urllib.error.HTTPError, urllib.error.URLError) as exc:
                print(f"  {label} run {i + 1}: failed -- {exc}", file=sys.stderr)
                continue
            samples.append(sample)
            if verbose:
                print(
                    f"  {label} run {i + 1}: {sample['gen_tps']:.1f} tok/s, "
                    f"ttft {sample['ttft']:.2f}s, "
                    f"total {sample['total_s']:.1f}s",
                    file=sys.stderr,
                )

        win_end = time.time() if power else None
        if not samples:
            continue

        median = lambda key: statistics.median(s[key] for s in samples)  # noqa: E731
        yield {
            # Power is resolved after the run: powermetrics samples are only
            # parsed once the process is stopped, so there is nothing to look
            # up yet at yield time.
            "_window": (win_start, win_end) if power else None,
            "_generated": sum(s["completion_tokens"] for s in samples),
            "model": target,
            "backend": backend,
            "size": label,
            # A short prompt's ttft is mostly fixed overhead, so dividing by it
            # says nothing about prefill speed. Only report the rate for sizes
            # large enough to swamp that overhead.
            "sized": size > 0,
            "prompt_tokens": round(median("prompt_tokens")),
            "completion_tokens": round(median("completion_tokens")),
            "gen_tps": median("gen_tps"),
            "decode_tps": median("decode_tps"),
            "ttft": median("ttft"),
            "ttft_client": median("ttft_client"),
            # What the user actually waits for: prompt in, last token out, at
            # this row's fixed completion length. The one figure that is
            # directly comparable across backends.
            "total_s": median("total_s"),
            "prefill_tps": median("prefill_tps"),
            "runs": len(samples),
            # Spread across runs, as a fraction of the median ttft. A healthy
            # run sits near zero; anything large means the samples disagree,
            # usually a KV cache hit making one run implausibly fast. Surfaced
            # so a contaminated median cannot pass for a clean one.
            "ttft_spread": (
                (max(s["ttft"] for s in samples) - min(s["ttft"] for s in samples))
                / median("ttft")
                if median("ttft")
                else 0.0
            ),
        }


################################################################################
# Output


def print_table(rows, power=False):
    if not rows:
        print("No results.", file=sys.stderr)
        return
    width = max(len(r["model"]) for r in rows)
    header = (
        f"\n{'model':<{width}}  {'prompt':>7}  {'gen tok/s':>9}  "
        f"{'ttft':>7}  {'total':>7}  {'prefill tok/s':>13}  "
        f"{'runs':>4}  {'spread':>7}"
    )
    if power:
        header += f"  {'watts':>6}  {'over idle':>9}  {'tok/Wh':>7}"
    print(header)

    suspect = False
    for row in rows:
        prefill = f"{row['prefill_tps']:.0f}" if row["sized"] else "-"
        flag = "!" if row["ttft_spread"] > 0.25 else " "
        suspect = suspect or flag == "!"
        total = f"{row['total_s']:.1f}s" if row.get("total_s") else "-"
        line = (
            f"{row['model']:<{width}}  {row['size']:>7}  {row['gen_tps']:>9.1f}  "
            f"{row['ttft']:>6.2f}s  {total:>7}  {prefill:>13}  {row['runs']:>4}  "
            f"{row['ttft_spread'] * 100:>6.0f}%{flag}"
        )
        if power:
            w = f"{row['watts']:.1f}" if row.get("watts") else "-"
            idle = row.get("idle_watts")
            over = f"+{row['watts'] - idle:.1f}" if row.get("watts") and idle else "-"
            t = f"{row['tokens_per_wh']:.0f}" if row.get("tokens_per_wh") else "-"
            line += f"  {w:>6}  {over:>9}  {t:>7}"
        print(line)

    if power:
        total = sum(r["energy_wh"] for r in rows if r.get("energy_wh"))
        incr = sum(r["incremental_wh"] for r in rows if r.get("incremental_wh"))
        idle = next((r["idle_watts"] for r in rows if r.get("idle_watts")), None)
        if total:
            print(f"\ntotal energy: {total:.2f} Wh, of which {incr:.2f} Wh is above "
                  f"idle ({idle:.1f} W baseline)")
            print("SoC package only -- excludes DRAM, PSU losses, rest of machine")
    if suspect:
        print(
            "\n! runs disagree by >25% on ttft -- likely a KV cache hit. "
            "Re-run with more iterations (-n) before trusting that row.",
            file=sys.stderr,
        )


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "models",
        nargs="*",
        help="targets to benchmark: an LM Studio model id, optionally with a "
        "variant (qwen/qwen3.6-27b@4bit), or Apple's on-device model as "
        "fm:system. Default: every chat model LM Studio has.",
    )
    parser.add_argument(
        "-n", "--runs", type=int, default=3, help="timed runs per size (default: 3)"
    )
    parser.add_argument(
        "-m",
        "--max-tokens",
        type=int,
        default=256,
        help="tokens to generate per run (default: 256)",
    )
    parser.add_argument(
        "-s",
        "--sizes",
        default="0,4000",
        help="comma-separated prompt sizes in tokens; 0 means a short prompt "
        "(default: 0,4000)",
    )
    parser.add_argument("--json", action="store_true", help="emit JSON, not a table")
    parser.add_argument(
        "--no-unload",
        action="store_true",
        help="do not unload resident models first; benchmark whatever is "
        "already loaded (use when the caller has selected a specific variant)",
    )
    parser.add_argument(
        "--label",
        help="name to record in results instead of the model id (e.g. a "
        "variant like qwen/qwen3.6-27b@4bit)",
    )
    parser.add_argument(
        "--power-log",
        metavar="FILE",
        help="attribute energy using a powermetrics log written by someone "
        "else (this tool never runs sudo). Start it first with: sudo "
        "powermetrics --samplers cpu_power,gpu_power -i 1000 -o FILE. "
        "Without this, no energy is measured and none is reported.",
    )
    parser.add_argument(
        "-v", "--verbose", action="store_true", help="print each individual run"
    )
    args = parser.parse_args()

    models = args.models or list_models()
    if not models:
        sys.exit("LM Studio reports no chat models.")
    sizes = [int(s) for s in args.sizes.split(",") if s.strip()]

    power = None
    if args.power_log:
        # Fail up front rather than after a 40-minute run, but only on things
        # knowable now: the log may legitimately be empty until the first
        # sample lands.
        if not os.path.exists(args.power_log):
            sys.exit(
                f"power log {args.power_log} does not exist.\n"
                "Start the sampler first:\n"
                "  sudo powermetrics --samplers cpu_power,gpu_power "
                f"-i 1000 -o {args.power_log} &"
            )
        power = PowerLog(args.power_log)
        print(f"will attribute energy from {args.power_log}", file=sys.stderr)
    else:
        print(
            "NOT measuring power -- throughput only. Any energy figure derived "
            "from these results is an assumption, not a measurement. "
            "Pass --power-log FILE to measure it.",
            file=sys.stderr,
        )

    rows = []
    for model in models:
        for row in bench_model(
            model, sizes, args.runs, args.max_tokens, args.verbose,
            unload=not args.no_unload, power=power,
        ):
            if args.label:
                row["model"] = args.label
            rows.append(row)

    # Parse only now, so the log covers the whole run.
    if power:
        power.parse()
        if not power.samples:
            print("WARNING: no usable samples in the power log; "
                  "is powermetrics still running?", file=sys.stderr)
        windows = [r["_window"] for r in rows if r.get("_window")]
        idle = power.compute_idle(windows)
        if idle is None:
            print("WARNING: no samples fell outside the benchmark windows, so "
                  "there is no idle baseline; incremental energy unavailable.",
                  file=sys.stderr)

    for row in rows:
        window = row.pop("_window", None)
        generated = row.pop("_generated", 0)
        watts = energy_wh = incr_wh = tokens_per_wh = None
        if power and window:
            watts, energy_wh, incr_wh = power.window(*window)
            if incr_wh:
                # Tokens per incremental watt-hour: the efficiency figure that
                # matters on a machine that is left on regardless.
                tokens_per_wh = generated / incr_wh
        row["watts"] = watts
        row["energy_wh"] = energy_wh
        row["incremental_wh"] = incr_wh
        row["tokens_per_wh"] = tokens_per_wh
        if power:
            row["idle_watts"] = power.idle_watts

    if args.json:
        print(json.dumps(rows, indent=2))
    else:
        print_table(rows, power=bool(power))


if __name__ == "__main__":
    main()
