# Main


REFUSAL_MARKERS = (
    "unsafe",
    "cannot assist",
    "can't assist",
    "i'm unable",
    "guardrail",
    "not able to help",
)


def looks_refused(text, finish_reason):
    if finish_reason in ("content_filter", "guardrail", "refusal"):
        return True
    head = text.strip().lower()[:200]
    return any(marker in head for marker in REFUSAL_MARKERS)


def load_done(path, budgets=None):
    """Existing results, so a restarted run resumes rather than repeats.

    An item that errored does not count as done. Errors here mean the server
    went away mid-run, not that the model got the question wrong, and leaving
    them in would bake a server outage into the score as a pile of zeroes.
    Re-running the same output file retries exactly those items.

    The last record for an item wins, so a retry supersedes the failure it
    replaces without the file needing to be rewritten.
    """
    done, by_key = set(), {}
    if not path.exists():
        return done, []
    for line in path.read_text().splitlines():
        if not line.strip():
            continue
        row = json.loads(line)
        key = (row["model"], row.get("mode", "no-think"), row["id"])
        by_key[key] = row
        if row.get("error") or _budget_was_raised(row, budgets):
            done.discard(key)
        else:
            done.add(key)
    return done, list(by_key.values())


def _budget_was_raised(row, budgets):
    """True if this row was truncated under a budget smaller than today's.

    Re-running only the truncated items under a larger ceiling is equivalent to
    having used the larger ceiling all along -- an answer that stopped on its
    own would not have changed. Rows truncated at the *current* budget are left
    alone, so repeated resumes do not retry them forever.
    """
    if not budgets or row.get("finish_reason") != "length":
        return False
    recorded = row.get("max_tokens")
    if recorded is None:
        # Written before the budget was recorded; those all used the old cap.
        recorded = 512 if row.get("task") == "gsm8k" else 8
    return recorded < budgets.get(row.get("task"), 0)


def regrade(path, items_path):
    """Re-judge stored code answers, rewriting the file in place.

    Generation is the expensive half of a code run -- hours on the dense 8-bit
    builds -- and grading is cheap, so a grader fix should not cost a re-run.
    """
    items = {
        i["id"]: i
        for i in (json.loads(l) for l in items_path.read_text().splitlines() if l.strip())
    }
    lines = path.read_text().splitlines()
    changed = 0
    out = []
    for line in lines:
        if not line.strip():
            continue
        row = json.loads(line)
        if row.get("task") == "code" and not row.get("error") and row["id"] in items:
            ok, got = grade(items[row["id"]], row.get("text") or "")
            if (ok, got) != (row.get("correct"), row.get("got")):
                changed += 1
            row["correct"], row["got"] = ok, got
        out.append(json.dumps(row))
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text("\n".join(out) + "\n")
    tmp.replace(path)
    print(f"regraded {path}: {changed} verdicts changed")
    _, rows = load_done(path)
    print_summary(summarise(rows))


def main():
    ap = argparse.ArgumentParser(
        description="Grade local models on fixed GSM8K, MMLU, and LiveCodeBench item sets."
    )
    ap.add_argument(
        "targets",
        nargs="*",
        help="backend:model, e.g. lmstudio:qwen/qwen3.6-27b@4bit or fm:system",
    )
    ap.add_argument("-o", "--out", default="quality-results.jsonl")
    ap.add_argument("-i", "--items", help="item file (default: by task)")
    ap.add_argument(
        "--task",
        choices=list(TASKS),
        help="run one task only; `code` is never run unless asked for",
    )
    ap.add_argument("-n", "--limit", type=int, help="first N items of each task")
    ap.add_argument(
        "--think",
        action="store_true",
        help="leave the model's reasoning mode on (much slower; see docstring)",
    )
    ap.add_argument("--score", metavar="FILE", help="summarise an existing result file")
    ap.add_argument("--json", action="store_true", help="summary as JSON")
    ap.add_argument(
        "--regrade",
        metavar="FILE",
        help="re-run the code grader on the answers stored in FILE, in place",
    )
    args = ap.parse_args()

    if args.regrade:
        regrade(Path(args.regrade), Path(args.items or CODE_ITEMS))
        return

    if args.score:
        _, rows = load_done(Path(args.score))
        summaries = summarise(rows)
        print(json.dumps(summaries, indent=2) if args.json else "", end="")
        if not args.json:
            print_summary(summaries)
        return

    if not args.targets:
        ap.error("no targets given")

    items_path = args.items or (CODE_ITEMS if args.task == "code" else ITEMS)
    items = [json.loads(l) for l in Path(items_path).read_text().splitlines() if l.strip()]
    if args.task:
        items = [i for i in items if i["task"] == args.task]
    if args.limit:
        kept, seen = [], {}
        for item in items:
            seen[item["task"]] = seen.get(item["task"], 0) + 1
            if seen[item["task"]] <= args.limit:
                kept.append(item)
        items = kept

    mode = "think" if args.think else "no-think"
    budgets = MAX_TOKENS_THINK if args.think else MAX_TOKENS
    out_path = Path(args.out)
    done, _ = load_done(out_path, budgets)

    try:
        for target in args.targets:
            backend, _, model = target.partition(":")
            if backend not in BACKENDS:
                sys.exit(f"unknown backend {backend!r} in {target!r}")
            if backend == "fm":
                ensure_fm_server()
            else:
                unload_lmstudio()

            pending = [i for i in items if (model, mode, i["id"]) not in done]
            print(
                f"\n=== {target} [{mode}] {len(pending)} items "
                f"({len(items) - len(pending)} already done) ===",
                flush=True,
            )
            started = time.time()
            correct_so_far = 0

            with out_path.open("a") as fh:
                for n, item in enumerate(pending, 1):
                    prompt = build_prompt(item)
                    t0 = time.time()
                    try:
                        reply = BACKENDS[backend](
                            model, prompt, budgets[item["task"]], args.think
                        )
                        error = None
                    except Exception as exc:  # noqa: BLE001 - recorded, not raised
                        reply = {
                            "text": "",
                            "finish_reason": "error",
                            "completion_tokens": None,
                            "reasoning_tokens": None,
                            "prompt_tokens": None,
                        }
                        error = f"{type(exc).__name__}: {exc}"
                    latency = time.time() - t0

                    try:
                        ok, got = grade(item, reply["text"])
                    except FileNotFoundError:
                        raise
                    except Exception as exc:  # noqa: BLE001 - a grader bug must not end the run
                        ok, got = False, f"grader_error:{type(exc).__name__}: {exc}"[:200]
                    correct_so_far += ok
                    record = {
                        "model": model,
                        "backend": backend,
                        "mode": mode,
                        "id": item["id"],
                        "task": item["task"],
                        "subject": item.get("subject"),
                        "expected": item["answer"],
                        "got": got,
                        "correct": ok,
                        "refused": looks_refused(reply["text"], reply["finish_reason"]),
                        "finish_reason": reply["finish_reason"],
                        "max_tokens": budgets[item["task"]],
                        "completion_tokens": reply["completion_tokens"],
                        "reasoning_tokens": reply["reasoning_tokens"],
                        "prompt_tokens": reply["prompt_tokens"],
                        "latency_s": round(latency, 3),
                        "error": error,
                        # Code answers are kept whole so --regrade can re-judge
                        # them without regenerating.
                        "text": reply["text"] if item["task"] == "code" else reply["text"][:2000],
                    }
                    fh.write(json.dumps(record) + "\n")
                    fh.flush()

                    if n % 25 == 0 or n == len(pending) or item["task"] == "code":
                        rate = (time.time() - started) / n
                        remaining = rate * (len(pending) - n)
                        print(
                            f"  {n}/{len(pending)}  {100*correct_so_far/n:.1f}% correct  "
                            f"{rate:.2f}s/item  ~{remaining/60:.0f}m left",
                            flush=True,
                        )
    finally:
        proc = _fm_state.get("proc")
        if proc and proc.poll() is None:
            proc.terminate()

    _, rows = load_done(out_path)
    print()
    print_summary(summarise(rows))


if __name__ == "__main__":
    main()
