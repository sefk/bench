################################################################################
# Prompting


def build_code_prompt(item):
    if item["starter_code"]:
        fmt, code = CODE_FORMAT_STARTER, item["starter_code"]
    else:
        fmt, code = CODE_FORMAT_STDIN, "# YOUR CODE HERE"
    return (
        f"{CODE_PREAMBLE}\n\n### Question:\n{item['question']}\n\n"
        f"### Format: {fmt}\n```python\n{code}\n```\n\n"
        f"### Answer: (use the provided format with backticks)\n"
    )


def build_prompt(item):
    if item["task"] == "code":
        return build_code_prompt(item)
    if item["task"] == "gsm8k":
        return f"{GSM8K_INSTRUCTIONS}\n\n{item['question']}"
    choices = "\n".join(
        f"{letter}. {text}"
        for letter, text in zip("ABCD", item["choices"])
    )
    return f"{MMLU_INSTRUCTIONS}\n\n{item['question']}\n{choices}"


################################################################################
# Grading


def grade_gsm8k(text, expected):
    """Prefer the '#### <n>' line; fall back to the last number in the text.

    The fallback matters for weaker models, which often solve the problem and
    then ignore the format instruction. Grading only the strict form would
    measure instruction-following as much as arithmetic.
    """
    marked = re.findall(r"####\s*(-?[\d,]*\.?\d+)", text)
    candidates = marked or re.findall(r"(-?[\d,]*\.?\d+)", text)
    if not candidates:
        return False, None
    got = candidates[-1].replace(",", "")
    try:
        return abs(float(got) - float(expected)) < 1e-4, got
    except ValueError:
        return False, got


def grade_mmlu(text, expected):
    """First standalone A-D letter wins.

    Anchored to a word boundary so 'A' in 'A helium atom...' is not read as an
    answer while '(B)' and 'B.' still are.
    """
    match = re.search(r"\b([ABCD])\b", text.strip().upper())
    got = match.group(1) if match else None
    return got == expected, got


################################################################################
# Code grading
#
# Mirrors LiveCodeBench's harness: a common import prelude, 6 s per test, and
# the program must pass every test. Grading stops at the first failure, so a
# wrong program costs one test's time rather than forty.
#
# Generated code is untrusted, so it runs under `sandbox-exec` with the network
# denied and writes confined to a scratch directory. There is no memory cap --
# macOS does not enforce RLIMIT_AS -- so a runaway allocation is bounded only
# by the timeout.

CODE_TIMEOUT_S = 6

CODE_PRELUDE = """\
from string import *
from re import *
from datetime import *
from collections import *
from heapq import *
from bisect import *
from copy import *
from math import *
from random import *
from statistics import *
from itertools import *
from functools import *
from operator import *
from io import *
from sys import *
from json import *
from builtins import *
from typing import *
import string, re, datetime, collections, heapq, bisect, copy, math, random
import statistics, itertools, functools, operator, io, sys, json
sys.setrecursionlimit(50000)
"""

# Runs every functional (LeetCode-style) test in one process. Each input line
# is one JSON-encoded argument; the result is compared after a JSON round
# trip, so a returned tuple matches an expected list.
FUNCTIONAL_DRIVER = """
import json as _json, signal as _signal, sys as _sys

def _alarm(*_):
    raise TimeoutError

_signal.signal(_signal.SIGALRM, _alarm)
with open(_sys.argv[1]) as _fh:
    _tests = _json.load(_fh)
_verdict = "pass"
for _i, _t in enumerate(_tests):
    try:
        _args = [_json.loads(_line) for _line in _t["input"].split("\\n")]
        _signal.alarm(%d)
        _got = getattr(Solution(), %r)(*_args)
        _signal.alarm(0)
    except TimeoutError:
        _verdict = "timeout@%%d" %% _i
        break
    except BaseException as _exc:
        _signal.alarm(0)
        _verdict = "runtime_error@%%d:%%s" %% (_i, type(_exc).__name__)
        break
    try:
        _ok = _json.loads(_json.dumps(_got)) == _json.loads(_t["output"])
    except (TypeError, ValueError):
        _ok = False
    if not _ok:
        _verdict = "wrong_answer@%%d" %% _i
        break
_sys.__stdout__.write("\\n@@VERDICT@@" + _verdict + "\\n")
"""


def extract_code(text):
    """The last fenced block, as LiveCodeBench does.

    Models often show the sample input in a block first and the solution
    after, so the last one is the answer. No fence means no answer.
    """
    blocks = re.findall(r"```[^\n`]*\n(.*?)```", text, re.S)
    if not blocks:
        # An answer cut off by the token budget has an opening fence only.
        tail = re.search(r"```(?:python|py)?\n(.*)$", text, re.S)
        return tail.group(1) if tail else ""
    return blocks[-1]


def load_code_tests(item_id):
    path = CODE_TESTS / f"{item_id}.json.gz"
    if not path.exists():
        raise FileNotFoundError(
            f"{path} missing -- build it with quality/make-code-items.py"
        )
    with gzip.open(path, "rt") as fh:
        return json.load(fh)


def _sandbox_profile(workdir):
    return (
        "(version 1)\n(allow default)\n(deny network*)\n"
        "(deny file-write*)\n"
        f'(allow file-write* (subpath "{os.path.realpath(workdir)}") '
        '(literal "/dev/null") (literal "/dev/dtracehelper"))\n'
    )


def _limit_child():
    # A CPU cap as a backstop to the wall-clock timeout, and no core files.
    resource.setrlimit(resource.RLIMIT_CPU, (60, 60))
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))


def _run_sandboxed(workdir, argv, stdin_text, timeout):
    cmd = ["sandbox-exec", "-p", _sandbox_profile(workdir), sys.executable, "-B", "-I", *argv]
    try:
        proc = subprocess.run(
            cmd,
            input=stdin_text,
            capture_output=True,
            text=True,
            timeout=timeout,
            cwd=workdir,
            preexec_fn=_limit_child,
            errors="replace",
        )
    except subprocess.TimeoutExpired:
        return None
    return proc


def outputs_match(got, expected):
    """Line-by-line, whitespace-insensitive, numbers compared as numbers.

    LiveCodeBench compares tokens exactly or as Decimals. This also accepts
    floats within 1e-6, which is what AtCoder's own judge does for the
    problems that print real numbers.
    """
    got_lines = [l.split() for l in got.strip().splitlines()]
    exp_lines = [l.split() for l in expected.strip().splitlines()]
    got_lines = [l for l in got_lines if l]
    exp_lines = [l for l in exp_lines if l]
    if len(got_lines) != len(exp_lines):
        return False
    for g_line, e_line in zip(got_lines, exp_lines):
        if len(g_line) != len(e_line):
            return False
        for g, e in zip(g_line, e_line):
            if g == e:
                continue
            try:
                gf, ef = float(g), float(e)
            except ValueError:
                return False
            if not (math.isfinite(gf) and math.isfinite(ef)):
                return False
            if not math.isclose(gf, ef, rel_tol=1e-6, abs_tol=1e-6):
                return False
    return True


def run_code_tests(code, item, tests):
    """Returns a verdict: 'pass', or '<kind>@<test index>'."""
    if not code.strip():
        return "no_code"
    with tempfile.TemporaryDirectory(prefix="qb-code-") as workdir:
        if item["testtype"] == "functional":
            with open(os.path.join(workdir, "tests.json"), "w") as fh:
                json.dump(tests, fh)
            driver = FUNCTIONAL_DRIVER % (CODE_TIMEOUT_S, item["func_name"])
            with open(os.path.join(workdir, "sol.py"), "w") as fh:
                fh.write(CODE_PRELUDE + "\n" + code + "\n" + driver)
            proc = _run_sandboxed(
                workdir, ["sol.py", "tests.json"], "",
                CODE_TIMEOUT_S * len(tests) + 10,
            )
            if proc is None:
                return "timeout@?"
            marker = proc.stdout.rsplit("@@VERDICT@@", 1)
            if len(marker) != 2:
                err = (proc.stderr.strip().splitlines() or ["?"])[-1][:80]
                return f"runtime_error@load:{err}"
            return marker[1].strip()

        with open(os.path.join(workdir, "sol.py"), "w") as fh:
            fh.write(CODE_PRELUDE + "\n" + code + "\n")
        for i, test in enumerate(tests):
            proc = _run_sandboxed(workdir, ["sol.py"], test["input"], CODE_TIMEOUT_S)
            if proc is None:
                return f"timeout@{i}"
            if proc.returncode != 0:
                err = (proc.stderr.strip().splitlines() or ["?"])[-1][:80]
                return f"runtime_error@{i}:{err}"
            if not outputs_match(proc.stdout, test["output"]):
                return f"wrong_answer@{i}"
        return "pass"


def grade_code(text, item):
    verdict = run_code_tests(extract_code(text), item, load_code_tests(item["id"]))
    return verdict == "pass", verdict


def grade(item, text):
    if item["task"] == "code":
        return grade_code(text, item)
    if item["task"] == "gsm8k":
        return grade_gsm8k(text, item["answer"])
    return grade_mmlu(text, item["answer"])


################################################################################
# Backends


def http_json(url, payload, timeout=900):
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode()


# LM Studio drops out mid-run: it unloads the model and then refuses to
# reload it while the machine is briefly under pressure, answering HTTP 400
# (its resource guardrail) or 500. A single pass lost 154 consecutive items
# that way. The condition clears on its own, so back off and retry rather than
# recording a hundred "wrong answers" that are really one server hiccup.
LMSTUDIO_RETRIES = 4
LMSTUDIO_BACKOFF = 15


def ask_lmstudio(model, prompt, max_tokens, think):
    messages = [{"role": "user", "content": prompt}]
    if not think:
        messages.append({"role": "assistant", "content": NO_THINK_PREFILL})
    payload = {
        "model": model,
        "messages": messages,
        "temperature": 0,
        "max_tokens": max_tokens,
        "stream": False,
    }

    for attempt in range(LMSTUDIO_RETRIES):
        try:
            raw = http_json(LMSTUDIO_URL, payload)
            break
        except urllib.error.HTTPError as exc:
            # 4xx that is not the resource guardrail means the request itself
            # is wrong -- retrying will not fix it.
            if exc.code not in (400, 429, 500, 502, 503) or attempt == LMSTUDIO_RETRIES - 1:
                raise
            time.sleep(LMSTUDIO_BACKOFF * (attempt + 1))
        except (urllib.error.URLError, ConnectionError, TimeoutError):
            if attempt == LMSTUDIO_RETRIES - 1:
                raise
            time.sleep(LMSTUDIO_BACKOFF * (attempt + 1))

    body = json.loads(raw)
    # LM Studio does NOT error on an unresolvable variant id -- it silently
    # answers with whatever model happens to be resident. `qwen3.8-27b@q4_k_m`
    # returns `qwen3.6-35b-a3b@4bit` once that GGUF build is off disk. Without
    # this check a whole run gets attributed to the wrong model.
    served = body.get("model")
    if served and served != model:
        raise RuntimeError(
            f"asked for {model!r}, server answered as {served!r} -- "
            "the variant is probably not on disk"
        )

    choice = body["choices"][0]
    usage = body.get("usage", {})
    return {
        "text": choice["message"].get("content") or "",
        "finish_reason": choice.get("finish_reason"),
        "completion_tokens": usage.get("completion_tokens"),
        "reasoning_tokens": (usage.get("completion_tokens_details") or {}).get(
            "reasoning_tokens"
        ),
        "prompt_tokens": usage.get("prompt_tokens"),
    }


def ask_fm(model, prompt, max_tokens, think):
    """`fm serve` only ever streams, and reports no token usage."""
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0,
        "max_tokens": max_tokens,
    }
    for attempt in range(3):
        try:
            raw = http_json(FM_URL, payload)
            break
        except (urllib.error.URLError, ConnectionError, TimeoutError):
            # Distinguish "the server is gone" from "this request failed":
            # only the former is worth a restart, and only a live server that
            # still refuses the request should surface as a real error.
            if attempt == 2 or not fm_recover():
                raise
            time.sleep(1)
    chunks, finish = [], None
    for line in raw.splitlines():
        if not line.startswith("data: "):
            continue
        payload = line[6:].strip()
        if payload == "[DONE]":
            break
        try:
            event = json.loads(payload)
        except json.JSONDecodeError:
            continue
        for choice in event.get("choices", []):
            piece = (choice.get("delta") or {}).get("content")
            if piece:
                chunks.append(piece)
            if choice.get("finish_reason"):
                finish = choice["finish_reason"]
    return {
        "text": "".join(chunks),
        "finish_reason": finish,
        "completion_tokens": None,
        "reasoning_tokens": None,
        "prompt_tokens": None,
    }


BACKENDS = {"lmstudio": ask_lmstudio, "fm": ask_fm}


# `fm serve` does not survive a long unattended run: it stops accepting
# connections partway through and every later request fails instantly with
# ECONNREFUSED. A first attempt at this benchmark lost 550 of 750 fm items that
# way, and because the server's output was going to /dev/null there was nothing
# to show why. So: keep its log, notice when it dies, restart it, retry.
FM_LOG = HERE / ".tmp" / "fm-serve.log"
FM_RESTARTS_MAX = 20

_fm_state = {"proc": None, "restarts": 0}


def fm_alive():
    try:
        urllib.request.urlopen(f"http://localhost:{FM_PORT}/health", timeout=3).read()
        return True
    except Exception:
        return False


def start_fm_server(reason=""):
    """(Re)start `fm serve`, keeping its output for post-mortem."""
    old_proc = _fm_state.get("proc")
    if old_proc and old_proc.poll() is None:
        old_proc.terminate()
        try:
            old_proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            old_proc.kill()

    FM_LOG.parent.mkdir(parents=True, exist_ok=True)
    log = FM_LOG.open("a")
    log.write(f"\n--- start {time.strftime('%F %T')} {reason}\n")
    log.flush()
    proc = subprocess.Popen(
        ["fm", "serve", "--port", str(FM_PORT)], stdout=log, stderr=log
    )
    _fm_state["proc"] = proc

    for _ in range(80):
        if fm_alive():
            return proc
        if proc.poll() is not None:
            break
        time.sleep(0.5)
    sys.exit(
        f"fm serve did not come up on port {FM_PORT} "
        f"(exit={proc.poll()}); see {FM_LOG}"
    )


def ensure_fm_server():
    """Adopt a server that is already listening, or start one."""
    if fm_alive():
        return None
    return start_fm_server("initial")


def fm_recover():
    """Bring the server back after it has stopped answering.

    Returns False once the restart budget is spent, so a permanently broken
    server ends the run loudly instead of filling the results with errors.
    """
    if _fm_state["restarts"] >= FM_RESTARTS_MAX:
        return False
    _fm_state["restarts"] += 1
    print(
        f"  fm serve stopped answering; restarting "
        f"({_fm_state['restarts']}/{FM_RESTARTS_MAX})",
        flush=True,
    )
    start_fm_server(f"restart {_fm_state['restarts']}")
    return True


def unload_lmstudio():
    """Only one large model fits in 64 GB; a second trips an HTTP 400."""
    subprocess.run(
        ["lms", "unload", "--all"], capture_output=True, check=False
    )


################################################################################
# Scoring


def wilson(successes, total, z=1.96):
    """Wilson score interval.

    The normal approximation misbehaves near 0 and 1, which is exactly where a
    small on-device model lands on the harder subjects.
    """
    if total == 0:
        return 0.0, 0.0
    p = successes / total
    denom = 1 + z * z / total
    centre = (p + z * z / (2 * total)) / denom
    spread = z * ((p * (1 - p) / total + z * z / (4 * total * total)) ** 0.5) / denom
    return max(0.0, centre - spread), min(1.0, centre + spread)


def _score(rows):
    correct = sum(1 for r in rows if r["correct"])
    low, high = wilson(correct, len(rows))
    return {
        "n": len(rows),
        "correct": correct,
        "pct": 100 * correct / len(rows),
        "ci95": [100 * low, 100 * high],
    }


def summarise(rows):
    """Collapse per-item records into one summary per (model, mode).

    Rows that errored are dropped rather than scored as wrong: they measure the
    server's availability, not the model's answer. The count that each
    percentage is over is reported alongside it, so a target that lost items
    shows up as a smaller `n` instead of a quietly depressed score.
    """
    rows = [r for r in rows if not r.get("error")]
    groups = {}
    for row in rows:
        backend = row.get("backend", "lmstudio")
        groups.setdefault((backend, row["model"], row.get("mode", "no-think")), []).append(row)

    summaries = []
    for (backend, model, mode), items in sorted(groups.items()):
        # `target` is the same string the perf benchmark records in its
        # `model` field, so the dashboard can join quality onto throughput
        # without a second naming convention to keep in sync.
        target = f"fm:{model}" if backend == "fm" else model
        entry = {
            "model": model,
            "backend": backend,
            "target": target,
            "mode": mode,
            "n": len(items),
        }
        for task in TASKS:
            subset = [r for r in items if r["task"] == task]
            if subset:
                entry[task] = _score(subset)
        composite = [r for r in items if r["task"] in COMPOSITE_TASKS]
        if composite:
            entry["composite"] = _score(composite)
        entry["refused"] = sum(1 for r in items if r.get("refused"))
        entry["truncated"] = sum(
            1 for r in items if r.get("finish_reason") == "length"
        )
        entry["median_latency_s"] = sorted(r["latency_s"] for r in items)[
            len(items) // 2
        ]
        summaries.append(entry)
    return summaries


def print_summary(summaries):
    header = (
        f"{'model':<34} {'mode':<9} {'gsm8k':>7} {'mmlu':>7} {'code':>7} "
        f"{'composite':>20} {'ref':>4} {'trunc':>6}"
    )
    print(header)
    print("-" * len(header))
    for s in summaries:
        cells = [
            f"{s[task]['pct']:.1f}%" if task in s else "-" for task in TASKS
        ]
        comp = s.get("composite")
        composite = (
            f"{comp['pct']:.1f}% [{comp['ci95'][0]:.1f}-{comp['ci95'][1]:.1f}]"
            if comp else "-"
        )
        print(
            f"{s['model']:<34} {s['mode']:<9} {cells[0]:>7} {cells[1]:>7} {cells[2]:>7} "
            f"{composite:>20} {s['refused']:>4} {s['truncated']:>6}"
        )


