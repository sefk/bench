# Qwen3 skips its reasoning pass if the assistant turn is already open with a
# closed, empty think block. See the module docstring.
NO_THINK_PREFILL = "<think>\n\n</think>\n\n"

# Token budgets. MMLU wants one letter; GSM8K needs room for a worked solution.
# With --think both are raised, since the reasoning pass comes out of the same
# budget and a truncated answer grades as wrong.
#
# GSM8K's budget started at 512 and that was too tight to measure what it
# claimed to. At 512, all three Qwen builds scored 98% on the answers they
# finished, and their apparent differences (94.4 / 94.4 / 91.1) came entirely
# from how often they ran past the cap: 4.0%, 3.2% and 9.4% of items. The
# metric was ranking verbosity, not reasoning. Raising the ceiling puts the
# truncation rate low enough that the score is about the answers.
#
# Truncation is still reported per target, because a model that cannot finish
# inside a sane budget is a real cost -- it just should not masquerade as
# getting the sums wrong.
#
# Code gets 4096. Even with the reasoning pass switched off, Qwen works the
# problem through in prose before writing any code -- 1,300 tokens for an easy
# AtCoder B -- so a tight cap cuts off the answer before the code appears and
# repeats GSM8K's mistake of scoring verbosity. `fm serve` ignores the budget.
MAX_TOKENS = {"mmlu": 8, "gsm8k": 1536, "code": 4096}
MAX_TOKENS_THINK = {"mmlu": 1024, "gsm8k": 2048, "code": 8192}

# Tasks that make up the composite score. Code is reported on its own: folding
# it in would move every composite number recorded before it existed.
